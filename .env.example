# ============================================================
#  Sistema de Moeda Estudantil — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA comite o arquivo .env no repositório.
# ============================================================

# ----- PostgreSQL -----
POSTGRES_USER=moeda_user
POSTGRES_PASSWORD=moeda_pass
POSTGRES_DB=moeda_estudantil
POSTGRES_PORT=5432

# ----- pgAdmin (interface web do banco) -----
PGADMIN_EMAIL=admin@moeda.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ----- Back-end (Node.js / Express) -----
# URL de conexão usada pelo Prisma
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

PORT=3333
NODE_ENV=development

# ----- JWT (Sprint 03) -----
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=7d

# ----- E-mail / Nodemailer (Sprint 03) -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu_email@gmail.com
MAIL_PASS=sua_senha_de_app
MAIL_FROM="Sistema Moeda Estudantil <seu_email@gmail.com>"
