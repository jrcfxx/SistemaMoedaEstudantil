generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  ALUNO
  PROFESSOR
  EMPRESA
  ADMIN
}

enum StatusEmpresa {
  ATIVA
  INATIVA
}

enum TipoTransacao {
  ENVIO
  RECEBIMENTO
  RESGATE
}

enum StatusResgate {
  PENDENTE
  UTILIZADO
}

model Usuario {
  id        String      @id @default(cuid())
  nome      String
  email     String      @unique
  senhaHash String
  tipo      TipoUsuario
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  aluno           Aluno?
  professor       Professor?
  empresaParceira EmpresaParceira?

  @@map("usuarios")
}

model Instituicao {
  id        String   @id @default(cuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alunos      Aluno[]
  professores Professor[]

  @@map("instituicoes")
}

model Aluno {
  id            String   @id @default(cuid())
  nome          String
  email         String   @unique
  cpf           String   @unique
  rg            String
  endereco      String
  curso         String
  saldoMoedas   Int      @default(0)
  instituicaoId String
  usuarioId     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instituicao Instituicao      @relation(fields: [instituicaoId], references: [id])
  usuario     Usuario?         @relation(fields: [usuarioId], references: [id])
  transacoes  TransacaoMoeda[]
  resgates    Resgate[]

  @@map("alunos")
}

model EmpresaParceira {
  id        String        @id @default(cuid())
  nome      String
  email     String        @unique
  cnpj      String        @unique
  endereco  String
  telefone  String?
  status    StatusEmpresa @default(ATIVA)
  usuarioId String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  usuario   Usuario?   @relation(fields: [usuarioId], references: [id])
  vantagens Vantagem[]

  @@map("empresas_parceiras")
}

model Professor {
  id            String   @id @default(cuid())
  nome          String
  cpf           String   @unique
  departamento  String
  saldoMoedas   Int      @default(1000)
  instituicaoId String
  usuarioId     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instituicao Instituicao      @relation(fields: [instituicaoId], references: [id])
  usuario     Usuario?         @relation(fields: [usuarioId], references: [id])
  transacoes  TransacaoMoeda[]

  @@map("professores")
}

model Vantagem {
  id                String   @id @default(cuid())
  titulo            String
  descricao         String
  fotoUrl           String?
  custoMoedas       Int
  empresaParceiraId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  empresa    EmpresaParceira  @relation(fields: [empresaParceiraId], references: [id])
  transacoes TransacaoMoeda[]
  resgates   Resgate[]

  @@map("vantagens")
}

model TransacaoMoeda {
  id          String        @id @default(cuid())
  tipo        TipoTransacao
  valor       Int
  motivo      String
  alunoId     String
  professorId String?
  vantagemId  String?
  createdAt   DateTime      @default(now())

  aluno     Aluno      @relation(fields: [alunoId], references: [id])
  professor Professor? @relation(fields: [professorId], references: [id])
  vantagem  Vantagem?  @relation(fields: [vantagemId], references: [id])

  @@map("transacoes_moeda")
}

model Resgate {
  id          String        @id @default(cuid())
  codigoCupom String        @unique
  status      StatusResgate @default(PENDENTE)
  alunoId     String
  vantagemId  String
  createdAt   DateTime      @default(now())

  aluno    Aluno    @relation(fields: [alunoId], references: [id])
  vantagem Vantagem @relation(fields: [vantagemId], references: [id])

  @@map("resgates")
}
